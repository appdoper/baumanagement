# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://haus:haus_dev_pw@localhost:5432/hausmanagement?schema=public"

# Used by docker-compose.yml
POSTGRES_USER=haus
POSTGRES_PASSWORD=haus_dev_pw
POSTGRES_DB=hausmanagement
POSTGRES_PORT=5432

# ---------- Auth.js (NextAuth v5) ----------
# Generate AUTH_SECRET with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=""
ADMIN_EMAIL="admin@haus.local"
ADMIN_PASSWORD="change-me-in-production"
