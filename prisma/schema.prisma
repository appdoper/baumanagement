// Prisma schema — Hausmanagement
// Clean Architecture: this is the INFRASTRUCTURE persistence model.
// Domain entities (src/domain) are plain TS and do not depend on these types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (native, PostgreSQL) ----------
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPerson {
  KARL
  FELIX
  GEMEINSAM
}

enum DependencyType {
  FINISH_TO_START // FS: successor starts after predecessor finishes
  START_TO_START // SS: successor starts after predecessor starts
  FINISH_TO_FINISH // FF: reserved for later phases
  START_TO_FINISH // SF: reserved for later phases
}

enum UserRole {
  ADMIN
  USER
}

// ---------- Auth.js (NextAuth v5) ----------
// Credentials + JWT session strategy. Users are created by an admin with a
// generated password (scrypt-hashed in `passwordHash`); there is no email flow.
// Account/Session/VerificationToken are the standard adapter models, kept for a
// future adapter-backed provider though they stay empty with the JWT strategy.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  // Force a password change on next login (set for new users and admin resets).
  requiresPasswordChange Boolean @default(true)
  accounts      Account[]
  sessions      Session[]
  assignedTasks Task[]    @relation("TaskAssignee")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- WBS: hierarchical projects ----------
model Project {
  id          String  @id @default(cuid())
  name        String
  description String?

  parentId String?
  parent   Project?  @relation("ProjectTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Project[] @relation("ProjectTree")

  tasks Task[]

  // Standort tags (many-to-many). A project can carry several locations.
  locations Location[] @relation("ProjectLocations")

  // Soft delete: non-null means the project is logically deleted. Read queries
  // filter `deletedAt: null` so deletes never cascade-destroy data physically.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([deletedAt])
}

// ---------- Tasks ----------
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)

  // Optimistic concurrency control: bumped on every write. A client update must
  // carry the version it read; a mismatch means someone else edited meanwhile.
  version Int @default(1)

  // Soft delete (see Project.deletedAt).
  deletedAt DateTime?

  // Free-text procurement source (shop, supplier, URL, …). Not shown in lists.
  procurementSource String?

  // Who is responsible (Karl, Felix, or both). Used for filtering.
  person TaskPerson?

  // Money stored as integer cents to avoid float rounding errors
  estimatedCostCents Int?
  currency           String @default("EUR")

  // Timeline (for Gantt: planned vs. actual)
  plannedStart DateTime?
  plannedEnd   DateTime?
  deadline     DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Optional assignee — who is working on this task (set null if user removed)
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // One primary location per task (1:n)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  shops TaskShop[]

  attachments TaskAttachment[]

  dependenciesOut TaskDependency[] @relation("DependencyPredecessor")
  dependenciesIn  TaskDependency[] @relation("DependencySuccessor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([locationId])
  @@index([assigneeId])
  @@index([status])
  @@index([person])
  @@index([deletedAt])
}

// ---------- Dependencies (cross-project) ----------
model TaskDependency {
  id      String         @id @default(cuid())
  type    DependencyType @default(FINISH_TO_START)
  lagDays Int            @default(0)

  predecessorId String
  predecessor   Task   @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)

  successorId String
  successor   Task   @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([predecessorId, successorId, type])
  @@index([predecessorId])
  @@index([successorId])
}

// ---------- Locations (optionally hierarchical) ----------
model Location {
  id          String  @id @default(cuid())
  name        String
  description String?

  parentId String?
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationTree")

  tasks    Task[]
  projects Project[] @relation("ProjectLocations")

  createdAt DateTime @default(now())

  @@index([parentId])
}

// ---------- Shops / sources ----------
model Shop {
  id      String  @id @default(cuid())
  name    String
  url     String?
  address String?

  tasks TaskShop[]

  createdAt DateTime @default(now())
}

// ---------- Join: Task <-> Shop ----------
// File attachments (PDFs, images, …) stored inline in Postgres as bytea.
// `data` is only selected when streaming a download — never in list queries.
model TaskAttachment {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename String
  mimeType String
  size     Int
  data     Bytes

  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskShop {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  note   String?

  @@id([taskId, shopId])
  @@index([shopId])
}
